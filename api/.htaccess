<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>

<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>

<Files "ai_config.php">
    Order Allow,Deny
    Deny from all
</Files>

<Files "ai_estado.json">
    Order Allow,Deny
    Deny from all
</Files>